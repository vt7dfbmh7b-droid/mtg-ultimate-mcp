{
  "name": "mtg-ultimate-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "MCP-powered Magic: The Gathering card and printing knowledge, Commander deck analysis, pricing, colored-mana simulation, combo discovery, evidence analysis, and upgrade tooling.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}

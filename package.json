{
  "name": "mtg-ultimate-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP-powered Magic: The Gathering card knowledge, Commander deck analysis, combo discovery, and bracket tooling.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
